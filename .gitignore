# ignorar todo...
*
# ...excepto carpetas y estos tipos de fichero
!*/
!.gitignore
!*.c
!*.h
!*.pdf
!*.txt
!*.md
!Makefile
!makefile
!test*
!check_*
!*.mp4
!*.svg
# generador de la web y su estilo (se suben); la salida generada no
!sitio/construir.py
!sitio/estilo/*
!.github/workflows/*.yml
sitio/_site/
